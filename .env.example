# UI-only development (set true to bypass admin login during local UI dev)
NEXT_PUBLIC_AUTH_DISABLED=false

# Set true when serving over HTTPS in production
COOKIE_SECURE=false

# Directus API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8055

# Directus server-side static token (must have read access to conference_room, conference_room_request, general_setting, company_list, user)
DIRECTUS_STATIC_TOKEN=your_directus_static_token_here

# Optional custom HMAC secret for admin session cookies (defaults to DIRECTUS_STATIC_TOKEN)
# SESSION_SECRET=your_random_secret_here
